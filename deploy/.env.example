# Copy to deploy/.env (chmod 600) – docker compose reads it automatically.

# --- public address ----------------------------------------------------------
REVIEWER_HOST=reviewer.example.com
ACME_EMAIL=admin@example.com

# --- Microsoft Entra ID app registration (see README) ------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_ID=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_CLIENT_SECRET=<client secret from the app registration>
# 32 random bytes, base64:
#   python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=<32-byte base64 secret>

# --- app ---------------------------------------------------------------------
# Bootstrap admin(s), comma separated. Can be emptied once Entra app roles are assigned.
ADMIN_EMAILS=admin@example.com
# Role for signed-in users without an ADMIN/USER app role: "user" or "" (→ 403).
DEFAULT_ROLE=user
# Image tag to run – "latest" or a pinned release such as "0.1.0".
REVIEWER_TAG=latest
