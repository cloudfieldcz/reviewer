---
import Review from '~/components/Review.svelte';
import Layout from '~/layouts/Layout.astro';
import { projectAccess } from '~/lib/access';
import { normalizePagePath, normalizeViewport } from '~/lib/comments';
import { getProject } from '~/lib/projects';

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return Astro.redirect('/');
let project;
try {
  project = getProject(id);
} catch {
  return new Response('Project not found', { status: 404 });
}

const rawPath = Astro.url.searchParams.get('path');
let initialPath = '/';
try {
  initialPath = rawPath ? normalizePagePath(rawPath) : '/';
} catch {
  initialPath = '/';
}
// A comment link from the admin table carries the viewport it was written in.
const initialDevice = normalizeViewport(Astro.url.searchParams.get('device'));
// A shared link to one comment: the island focuses it (and restores its state) on the first frame load.
const rawComment = Number(Astro.url.searchParams.get('comment'));
const initialComment = Number.isInteger(rawComment) && rawComment > 0 ? rawComment : null;
const user = Astro.locals.user;
// A rendering hint for the island: owners are `role: 'user'`, so the island must not look at the role.
const access = projectAccess(project.id, user);
---

<Layout title={`Review · ${project.name}`} fullscreen>
  <Review
    client:only="svelte"
    project={{ id: project.id, name: project.name, baseUrl: project.baseUrl, kind: project.kind }}
    user={{ id: user.id, name: user.name }}
    access={access}
    initialPath={initialPath}
    initialDevice={initialDevice}
    initialComment={initialComment}
  />
</Layout>
