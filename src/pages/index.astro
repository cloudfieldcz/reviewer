---
import Layout from '~/layouts/Layout.astro';
import { listProjects } from '~/lib/projects';

const user = Astro.locals.user;
const projects = listProjects();
const isAdmin = user.role === 'admin';

const ago = (s: string) => {
  const diff = (Date.now() - new Date(s.replace(' ', 'T') + 'Z').getTime()) / 1000;
  if (diff < 3600) return `${Math.max(1, Math.round(diff / 60))} min ago`;
  if (diff < 86400) return `${Math.round(diff / 3600)} h ago`;
  if (diff < 604800) return `${Math.round(diff / 86400)} d ago`;
  return new Date(s.replace(' ', 'T') + 'Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};
---

<Layout title="Projects">
  <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Projects</h1>
        <p class="mt-1 text-sm text-gray-600">Every project is a website you can walk through and comment on, element by element.</p>
      </div>
      {
        isAdmin && (
          <button id="new-project-btn" class="btn-primary" type="button">
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M8 3.5v9M3.5 8h9" />
            </svg>
            New project
          </button>
        )
      }
    </div>

    {
      isAdmin && (
        <form id="new-project-form" class="card mb-6 hidden p-5" autocomplete="off">
          <h2 class="mb-4 text-sm font-semibold tracking-tight">New project</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="mb-1.5 block font-medium text-gray-700">Name</span>
              <input name="name" class="input" required maxlength="200" placeholder="Company website – redesign" />
            </label>
            <label class="block text-sm">
              <span class="mb-1.5 block font-medium text-gray-700">Website address</span>
              <input name="baseUrl" class="input font-mono text-xs" type="url" required placeholder="https://test.example.com" />
            </label>
          </div>
          <p id="probe-result" class="mt-3 min-h-5 text-sm text-gray-500" />
          <div class="mt-4 flex gap-2 border-t border-gray-100 pt-4">
            <button class="btn-primary" type="submit">
              Create project
            </button>
            <button class="btn-secondary" type="button" id="probe-btn">
              Check the address
            </button>
            <button class="btn-ghost" type="button" id="cancel-btn">
              Cancel
            </button>
          </div>
        </form>
      )
    }

    {
      projects.length === 0 ? (
        <div class="card px-6 py-16 text-center">
          <svg viewBox="0 0 24 24" class="mx-auto h-10 w-10 text-gray-300" aria-hidden="true">
            <rect x="2.6" y="3.6" width="14.8" height="14.8" rx="3.2" fill="none" stroke="currentColor" stroke-width="1.6" />
            <circle cx="17.6" cy="17.6" r="4.6" fill="currentColor" />
          </svg>
          <p class="mt-4 text-base font-medium text-gray-800">No projects yet</p>
          <p class="mt-1 text-sm text-gray-500">
            {isAdmin ? 'Add the website you want reviewed and share the link with your team.' : 'An admin has to add the first website before you can review it.'}
          </p>
        </div>
      ) : (
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <li class="card group relative flex flex-col p-4 transition-shadow hover:shadow-pop">
              <a href={`/review/${p.id}`} class="text-[15px] font-semibold tracking-tight text-gray-900 after:absolute after:inset-0 group-hover:text-brand">
                {p.name}
              </a>
              <span class="mt-1 truncate font-mono text-xs text-gray-500" title={p.baseUrl}>
                {p.baseUrl.replace(/^https?:\/\//, '')}
              </span>
              <div class="mt-auto border-t border-gray-100 pt-3">
                <p class="text-xs text-gray-500">
                  <span class="font-semibold text-gray-800 tabular-nums">{p.commentCount}</span> comment{p.commentCount === 1 ? '' : 's'}
                  {p.lastCommentAt && <span class="text-gray-400"> · last {ago(p.lastCommentAt)}</span>}
                </p>
                {/* z-10 keeps these above the card-wide stretched link on the project name */}
                <div class="relative z-10 mt-3 flex items-center gap-2">
                  <a href={`/review/${p.id}`} class="btn-primary">
                    Review
                    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
                    </svg>
                  </a>
                  {isAdmin && (
                    <a href={`/admin/projects/${p.id}`} class="btn-secondary">
                      Manage
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>

<script>
  const form = document.getElementById('new-project-form') as HTMLFormElement | null;
  if (form) {
    const show = (v: boolean) => {
      form.classList.toggle('hidden', !v);
      if (v) (form.elements.namedItem('name') as HTMLInputElement).focus();
    };
    document.getElementById('new-project-btn')!.addEventListener('click', () => show(true));
    document.getElementById('cancel-btn')!.addEventListener('click', () => show(false));

    const result = document.getElementById('probe-result')!;
    const urlInput = form.elements.namedItem('baseUrl') as HTMLInputElement;

    document.getElementById('probe-btn')!.addEventListener('click', async () => {
      result.textContent = 'Checking…';
      const res = await fetch('/api/projects/probe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ url: urlInput.value }),
      });
      const data = await res.json();
      result.className = 'mt-3 min-h-5 text-sm ' + (data.ok ? 'text-green-700' : 'text-red-700');
      result.textContent = data.ok
        ? `Reachable (HTTP ${data.status})${data.title ? ' – ' + data.title : ''}`
        : `Not reachable: ${data.error ?? 'HTTP ' + data.status}`;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const res = await fetch('/api/projects', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ name: fd.get('name'), baseUrl: fd.get('baseUrl') }),
      });
      if (res.ok) location.reload();
      else {
        const data = await res.json().catch(() => ({}));
        result.className = 'mt-3 min-h-5 text-sm text-red-700';
        result.textContent = data.error ?? `Error ${res.status}`;
      }
    });
  }
</script>
