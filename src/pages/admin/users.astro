---
import { desc, eq, sql } from 'drizzle-orm';
import Layout from '~/layouts/Layout.astro';
import { db, schema } from '~/lib/db';

if (Astro.locals.user.role !== 'admin') return new Response('Forbidden', { status: 403 });

const users = db
  .select({
    id: schema.users.id,
    email: schema.users.email,
    name: schema.users.name,
    role: schema.users.role,
    createdAt: schema.users.createdAt,
    lastSeenAt: schema.users.lastSeenAt,
    // Aggregate over a join – in a correlated subquery drizzle would render `schema.users.id`
    // as a bare `"id"`, which SQLite resolves against `comments` instead.
    commentCount: sql<number>`count(${schema.comments.id})`,
  })
  .from(schema.users)
  .leftJoin(schema.comments, eq(schema.comments.userId, schema.users.id))
  .groupBy(schema.users.id)
  .orderBy(desc(schema.users.lastSeenAt))
  .all();
const fmt = (s: string) => new Date(s.replace(' ', 'T') + 'Z').toLocaleString('en-GB', { timeZone: 'Europe/Prague', dateStyle: 'medium', timeStyle: 'short' });
---

<Layout title="Users">
  <main class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-semibold tracking-tight">Users</h1>
    <p class="mb-6 mt-1 max-w-2xl text-sm text-gray-600">
      Everyone who has signed in at least once. Roles come from Entra ID app roles (via oauth2-proxy) on every request – this table is only a cache of the last login.
    </p>
    <section class="card overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 text-left text-xs font-medium text-gray-500">
          <tr><th class="px-3 py-2">Name</th><th class="px-3 py-2">Email</th><th class="px-3 py-2">Role</th><th class="px-3 py-2">Comments</th><th class="px-3 py-2">First seen</th><th class="px-3 py-2">Last seen</th></tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {users.map((u) => (
            <tr class="transition-colors hover:bg-gray-50">
              <td class="px-3 py-2.5 font-medium">{u.name}</td>
              <td class="px-3 py-2.5 font-mono text-xs text-gray-600">{u.email}</td>
              <td class="px-3 py-2.5"><span class:list={['badge', u.role === 'admin' ? 'bg-brand-soft text-brand-dark' : 'bg-gray-100 text-gray-700']}>{u.role}</span></td>
              <td class="px-3 py-2.5 tabular-nums">{u.commentCount}</td>
              <td class="px-3 py-2.5 whitespace-nowrap text-gray-500">{fmt(u.createdAt)}</td>
              <td class="px-3 py-2.5 whitespace-nowrap text-gray-500">{fmt(u.lastSeenAt)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </main>
</Layout>
