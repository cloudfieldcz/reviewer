# --- local development (npm run dev) -----------------------------------------
# Fake identity when running without oauth2-proxy: "email[:role]" (role = admin | user).
# Ignored when NODE_ENV=production.
DEV_USER=admin@example.com:admin

# Allow projects pointing at localhost / private IPs and plain http (dev only).
ALLOW_PRIVATE_TARGETS=true
ALLOW_HTTP_TARGETS=true

# Where SQLite lives (default ./data/reviewer.db).
DATABASE_PATH=./data/reviewer.db

# --- production --------------------------------------------------------------
# Public origin of the app (used for absolute links inside proxied pages).
# PUBLIC_ORIGIN=https://reviewer.example.com

# Bootstrap admins (comma separated) – useful before Entra app roles are assigned. Empty in steady state.
# ADMIN_EMAILS=admin@example.com

# Role for signed-in users without an ADMIN/USER app role: "user" (everyone in the tenant may comment)
# or empty (403 – only users with an assigned app role get in).
# DEFAULT_ROLE=user
