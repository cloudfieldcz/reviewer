  "version": "0.1.5",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Website review tool – comments anchored to page elements via a reverse proxy.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudfieldcz/reviewer.git"
  },
  "scripts": {
    "dev": "astro dev",
