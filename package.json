    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.2",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
